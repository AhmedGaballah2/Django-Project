# OpenRouter (recommended) — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: use OPENAI_API_KEY instead if you prefer a single variable name
# OPENAI_API_KEY=

# OpenRouter OpenAI-compatible API (defaults shown)
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=openai/gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional metadata headers for OpenRouter
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=Courses Platform
